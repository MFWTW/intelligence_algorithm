<?xml version="1.0"?>
<robot name="six_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find mybot_description)/urdf/large_base.xacro" />

    <!-- Transmission is important to link the joints and the controller -->
    <xacro:macro name="wheel_transmission" params="prefix">
        <transmission name="${prefix}_wheel_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}_wheel_joint">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}_wheel_joint_motor">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <gazebo reference="${prefix}_wheel_link">
            <material>Gazebo/Gray</material>
            <!-- Keep ODE contact constraints well-conditioned. Extremely large
                 friction values can inject explosive impulses when a wheel or
                 caster catches an obstacle, launching the whole robot. -->
            <mu1>2.0</mu1>
            <mu2>2.0</mu2>
        </gazebo>
    </xacro:macro>

    <!-- /////////////////////////////////   Gazebo   ////////////////////////////////////// -->
    <gazebo reference="base_footprint">
        <turnGravityOff>false</turnGravityOff>
    </gazebo>
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="back_caster_link">
        <material>Gazebo/Black</material>
        <!-- The caster is a *fixed* sphere, not a swivelling wheel, so it has no
             steering degree of freedom: during an in-place rotation it must slide
             sideways along the floor. With Gazebo's default friction (mu = 1.0)
             it acted as a brake: the base reached only 64-73 % of every commanded
             yaw rate while straight-line tracking stayed at 99 %. Measured
             open-loop on a clean Gazebo instance (run_logs/tools/turn_test.py,
             ground-truth twist):
                 cmd wz 0.5 -> 0.319 rad/s (63.8 %)
                 cmd wz 1.0 -> 0.693 rad/s (69.3 %)
                 cmd wz 1.9 -> 1.383 rad/s (72.8 %)
             Nav2 kept correcting a heading it never reached, which reads as
             stuttering turns. 0.01 is the usual caster value; the drive wheels
             keep mu 2.0, so traction is unaffected. Note this sphere has no
             swivel joint at all, so low friction is the only way to let it slide
             without dragging; if turns ever feel loose, raise mu1/mu2 to ~0.05
             rather than reverting to the default. -->
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
    </gazebo>

    <xacro:wheel_transmission prefix="left" />
    <xacro:wheel_transmission prefix="right" />


    <!-- controller -->
    <gazebo>
        <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <update_rate>30</update_rate>
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <!-- Wheel joint origins are at y=+/-(base_width+wheel_length)/2,
                 so the physical centre-to-centre track is 0.370 m.  The old
                 wheel_joint_y*2 value was 0.760 m and made commanded turns
                 roughly twice as aggressive as the real chassis geometry. -->
            <wheel_separation>${base_width+wheel_length}</wheel_separation>
            <wheel_diameter>${2*wheel_radius}</wheel_diameter>
            <max_wheel_torque>10</max_wheel_torque>
            <max_wheel_acceleration>10.0</max_wheel_acceleration>
            <command_topic>cmd_vel</command_topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odometry_source>1</odometry_source>
	    <!-- 强制 2D 位姿，Z 轴恒为 0 -->
	    <odometry_2d_only>true</odometry_2d_only>
	  
	    <!-- 或者使用下面这个参数（不同版本可能不同） -->
	    <publish_odom_2d_only>true</publish_odom_2d_only>
        </plugin>
    </gazebo>
</robot>
