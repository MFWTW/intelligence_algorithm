<!--
  A/B candidate: keep the global route STABLE instead of recomputing it every
  0.333 s.

  Why (measured 2026-10-14, run_logs/gui_round_20261014-155217): with the mover
  boxes marked in the GLOBAL costmap (deliberate - see nav_rpp15.yaml: removing
  them made the base drive at a box and pace behind it), successive global plans
  picked opposite sides of a sweeping box. 71% of the observed direction
  reversals happened within 3 s of "Passing new path to controller" (median
  0.9 s), while yield cancels accounted for only 9%. The base shuttled 1.5 m/s
  between two points 2.7 m apart and spent 105 of 191 loaded-driving seconds in
  that one corridor.

  This tree plans only when there is no path yet, when the goal changed, or when
  the current path stopped being valid (a box actually blocking it). The local
  costmap still sees the boxes, so RPP keeps avoiding and refusing them, and the
  yield layer keeps holding; only the global route stops flipping.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <Fallback>
            <ReactiveSequence name="KeepValidPath">
              <Inverter>
                <GlobalUpdatedGoal/>
              </Inverter>
              <IsPathValid path="{path}"/>
            </ReactiveSequence>
            <ReactiveSequence name="ReplanThroughPoses">
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
            </ReactiveSequence>
          </Fallback>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
